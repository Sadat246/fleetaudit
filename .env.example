# Copy to .env.local. Both values are public (safe in the browser).
# Never put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Supabase "secret key" (sb_secret_...). Used only by the driver upload page and the daily job.
SUPABASE_SECRET_KEY=
# Local database tests only (npm run test:db). Not needed on Vercel.
DATABASE_URL=
# Twilio (optional until texting is approved). With all three set, texts are really sent;
# otherwise the app runs in test mode and only logs messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Protects the daily reminder job. Any long random string; Vercel sends it automatically.
CRON_SECRET=
